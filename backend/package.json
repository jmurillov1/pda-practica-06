{
  "name": "backend",
  "version": "1.0.0",
  "description": "API REST de gestión de empleados (CRUD) con Express, Mongoose y Zod",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "vitest run",
    "test:watch": "vitest",
    "stress": "artillery run stress-test.yml",
    "stress:reset-db": "node scripts/reset-stress-db.mjs",
    "test:unit:report": "NODE_OPTIONS=--experimental-vm-modules jest --json --outputFile=jest-results.json --coverage --coverageReporters=json-summary --coverageReporters=text",
    "stress:report": "pnpm stress:reset-db && pnpm test:unit:report && (artillery run --output artillery-report.json stress-test.yml; node scripts/generate-stress-report.mjs artillery-report.json ../docs/historial stress-test.yml jest-results.json coverage/coverage-summary.json)"
  },
  "keywords": [],
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@jest/globals": "^30.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.6.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.5.2",
    "prettier": "^3.4.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
